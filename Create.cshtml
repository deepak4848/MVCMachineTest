@model MTesting.Models.Student

@{
    ViewBag.Title = "Create";
}

<h2>Create</h2>

<script src="@Url.Content("~/Scripts/jquery.validate.min.js")" type="text/javascript"></script>
<script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")" type="text/javascript"></script>

@using (Html.BeginForm("Create", "Home", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(true)
    <div class="form-horizontal" style="margin-left:45%">
        <h3>Student</h3>

        <div class="editor-label">
            @Html.LabelFor(model => model.Name)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Name)
            @Html.ValidationMessageFor(model => model.Name)
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Department)
        </div>
        <div class="editor-field">
            @Html.DropDownListFor(model => model.Department, (IEnumerable<SelectListItem>)ViewBag.DeptList, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Department)
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Salary)
        </div>
        <div class="editor-field">
            @Html.EditorFor(model => model.Salary)
            @Html.ValidationMessageFor(model => model.Salary)
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.IsFullTime)
        </div>
        <div class="editor-field">
            @Html.RadioButtonFor(model => model.IsFullTime, "FullTime") FullTime
            @Html.RadioButtonFor(model => model.IsFullTime, "PartTime") PartTime
            @Html.ValidationMessageFor(model => model.IsFullTime)
        </div>

        <div class="editor-label">
            @Html.LabelFor(model => model.Skills)
        </div>
        <div class="editor-field">
            @*@Html.EditorFor(model => model.Skills)*@
             <input type="checkbox" name="Skills" value="C#" /> C#
            <input type="checkbox" name="Skills" value="Java" /> Java
            
             <input type="checkbox" name="Skills" value="Sql" /> Sql
            @Html.ValidationMessageFor(model => model.Skills)
        </div>
        <br />
        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <input type="submit" value="Create" style="background-color:lightgreen;width:100px;border-radius:20px;" />
                <span style="background-color:red;width:150px;border-radius:20px;color:white">
                @Html.ActionLink("Back to List", "Index", "", new { @class = "btn btn-danger" })</span>
            </div>
        </div>
    </div>
}


